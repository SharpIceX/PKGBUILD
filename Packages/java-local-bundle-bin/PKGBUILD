# shellcheck disable=SC2148 disable=SC2154 disable=SC2034

pkgname="java-local-bundle-bin"
pkgrel=1
arch=('x86_64')
pkgver=2026.11.17
options=('!strip')
license=('custom:Azul')
url='https://www.azul.com/downloads'
pkgdesc="Custom bundle of Zulu JDKs: 8, 11, 17, 21, and 25"

provides=(
  "java-runtime"
  "java-environment"
  "java-runtime-headless"

  # Java 8
  "java-runtime=8"
  "java-environment=8"
  "java-runtime-openjdk=8"
  "java-runtime-headless=8"
  "java-environment-openjdk=8"

  # Java 11
  "java-runtime=11"
  "java-environment=11"
  "java-runtime-openjdk=11"
  "java-runtime-headless=11"
  "java-environment-openjdk=11"

  # Java 17
  "java-runtime=17"
  "java-environment=17"
  "java-runtime-openjdk=17"
  "java-runtime-headless=17"
  "java-environment-openjdk=17"

  # Java 21
  "java-runtime=21"
  "java-environment=21"
  "java-runtime-openjdk=21"
  "java-runtime-headless=21"
  "java-environment-openjdk=21"

  # Java 25
  "java-runtime=25"
  "java-environment=25"
  "java-runtime-openjdk=25"
  "java-runtime-headless=25"
  "java-environment-openjdk=25"
)

depends=(
  # Java基础
  'java-runtime-common'
  'ca-certificates-utils'
  'java-environment-common'

  # 运行基础
  'nss'
  'zlib'
  'glibc'
  'gcc-libs'

  # 字体
  'lcms2'
  'harfbuzz'
  'freetype2'
  'fontconfig'

  # 图像处理
  'libpng'
  'giflib'
  'libjpeg-turbo'

  # X11 和 GUI
  'libxi'
  'libx11'
  'libxext'
  'libxtst'
  'libglvnd'
  'alsa-lib'
  'libxrender'
)

optdepends=(
  'gtk3: GTK3 look and feel for Swing/GUI applications'
  'gvfs: Open links and desktop integration'
  'hicolor-icon-theme: Desktop icon support'
)

source=(
  "${pkgname}-zulu8-fx.tar.gz::https://cdn.azul.com/zulu/bin/zulu8.98.0.111-ca-fx-jdk8.0.512-linux_x64.tar.gz"
  "${pkgname}-zulu11-fx.tar.gz::https://cdn.azul.com/zulu/bin/zulu11.92.113-ca-fx-jdk11.0.33-linux_x64.tar.gz"
  "${pkgname}-zulu17-fx.tar.gz::https://cdn.azul.com/zulu/bin/zulu17.70.113-ca-fx-jdk17.0.21.0.3-linux_x64.tar.gz"
  "${pkgname}-zulu21-fx.tar.gz::https://cdn.azul.com/zulu/bin/zulu21.54.109-ca-fx-jdk21.0.13.0.3-linux_x64.tar.gz"
  "${pkgname}-zulu25-fx.tar.gz::https://cdn.azul.com/zulu/bin/zulu25.38.109-ca-fx-jdk25.0.5.0.3-linux_x64.tar.gz"
)
sha256sums=(
    'b5e5a8607bab3b70f8bc9a1e527a45e94fb2099d9bad89d1c8e0defc17976bb2'
    'bb3f0f48a51f69d8a1feb093d725c01067b485e73aa77240be20bb3e99a27906'
    '5337e0507ed539f1c35f9e0d3c4c7669d594a66e5acb937f84b65a9777a14ebd'
    '8f5168f564c67cef3c4c371e6eb26f480799565659999da9aa3c142f9604e7ac'
    '58da871f1d12ff834e408cfa9c10ad3e5ca590bc4623dfb2421c449b1971518a')

package() {
  _install_jdk() {
    local v_num="$1"
    local folder_pre="$2"
    local dest_name="java-${v_num}-zulu"
    local jvmdir="/usr/lib/jvm/${dest_name}"
    local etcdir="/etc/zulu-bundle/${dest_name}"

    # 定位解压目录
    local src_paths=("$srcdir/${folder_pre}"*)
    local src_path="${src_paths[0]}"

    # 安装基本 JDK
    install -dm 755 "${pkgdir}${jvmdir}"
    cp -a "${src_path}/." "${pkgdir}${jvmdir}/"

    # 处理配置和证书库
    install -dm 755 "${pkgdir}${etcdir}"
    if [[ ${v_num} -eq 8 ]]; then
      # Java 8
      local target_sec="${jvmdir}/jre/lib/security"

      cp -r "${pkgdir}${target_sec}"/* "${pkgdir}${etcdir}/"
      ln -sf /etc/ssl/certs/java/cacerts "${pkgdir}${etcdir}/cacerts"

      rm -rf "${pkgdir}${target_sec}"
      ln -s "${etcdir}" "${pkgdir}${target_sec}"
    else
      # Java 11/17/21/25
      cp -r "${pkgdir}${jvmdir}/conf"/* "${pkgdir}${etcdir}/"
      rm -rf "${pkgdir}${jvmdir}/conf"
      ln -s "${etcdir}" "${pkgdir}${jvmdir}/conf"

      local cacerts_path="${jvmdir}/lib/security/cacerts"
      rm -f "${pkgdir}${cacerts_path}"
      ln -sf /etc/ssl/certs/java/cacerts "${pkgdir}${cacerts_path}"
    fi

    # 处理 Man Pages
    if [[ -d "${pkgdir}${jvmdir}/man/man1" ]]; then
      install -dm 755 "${pkgdir}/usr/share/man/man1"
      for m in "${pkgdir}${jvmdir}/man/man1"/*.1; do
        [[ -e "$m" ]] || continue
        local bname
        bname=$(basename "$m" .1)
        install -Dm 644 "$m" "${pkgdir}/usr/share/man/man1/${bname}-zulu${v_num}.1"
      done
      rm -rf "${pkgdir}${jvmdir}/man"
      ln -s /usr/share/man "${pkgdir}${jvmdir}/man"
    fi

    # 安装许可
    install -dm 755 "${pkgdir}/usr/share/licenses/${pkgname}/${dest_name}"
    for f in LICENSE ASSEMBLY_EXCEPTION THIRD_PARTY_README; do
      if [[ -f "${src_path}/$f" ]]; then
        cp "${src_path}/$f" "${pkgdir}/usr/share/licenses/${pkgname}/${dest_name}/"
      elif [[ -f "${src_path}/legal/java.base/$f" ]]; then
        cp "${src_path}/legal/java.base/$f" "${pkgdir}/usr/share/licenses/${pkgname}/${dest_name}/"
      fi
    done
  }

  for ver in "8:zulu8" "11:zulu11" "17:zulu17" "21:zulu21" "25:zulu25"; do
    _install_jdk ${ver%%:*} ${ver#*:}
  done
}
