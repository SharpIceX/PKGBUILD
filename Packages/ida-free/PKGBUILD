# 参考 patchouli aur/ida-pro 的打包

# shellcheck disable=SC2148 disable=SC2034 disable=SC2154

pkgver=9.5.0
pkgname="ida-free"
pkgrel=1
pkgdesc="Hex-Rays IDA Free"
url="https://hex-rays.com/ida-free"
license=('custom')
depends=(
    'glib2'
    'libgl'
    'libx11'
    'libxext'
    'libxrender'
    'python-rpyc'
    'qt6-base'
    'qt6-wayland'
)
makedepends=('fakechroot')
options=('!strip')

_installer='ida-free-pc_95_x64linux.run'

source=("file://${_installer}"
        "${pkgname}.desktop")

sha256sums=('c7828e9b3e87e6448fce171d42acb091a4318e67c28b9eb26ac11becb1e39c88'
            'SKIP')

arch=('x86_64')

package() {
    install -d "${pkgdir}"/opt/${pkgname}
    install -d "${pkgdir}"/usr/bin
    install -d "${pkgdir}"/usr/share/{icons,applications,licenses/${pkgname}}
    install -d "${pkgdir}"/tmp

    cp "${srcdir}"/${_installer} "${pkgdir}"/
    chmod +x "${pkgdir}"/${_installer}

    # IDA 9.0+ 的 BitRock 安装程序会忽略 prefix 强制向 $HOME 写入快捷方式
    mkdir -p "${pkgdir}/${HOME}"/.local/share/applications
    fakechroot chroot "${pkgdir}" /${_installer} --mode unattended --prefix "/opt/${pkgname}"

    # 清理无用文件
    rm -f "${pkgdir}"/${_installer}
    rm -Rf "${pkgdir:?}"/{tmp,home}

    # 修复 BitRock 安装程序误将所有文件设为可执行的问题
    find "${pkgdir}"/opt/${pkgname} -type f -exec chmod -x {} \;
    chmod +x "${pkgdir}"/opt/${pkgname}/{ida,picture_decoder}
    if [[ -d "${pkgdir}/opt/${pkgname}/tools" ]]; then
        find "${pkgdir}/opt/${pkgname}/tools" -type f | while read -r f; do
            if [[ "$(head -c 4 "$f" 2>/dev/null)" == $'\x7fELF' ]]; then
                chmod +x "$f"
            fi
        done
    fi

    if [[ -d "${pkgdir}/opt/${pkgname}/docs" ]]; then
        find "${pkgdir}"/opt/${pkgname}/docs -type d -exec chmod 755 {} \;
        find "${pkgdir}"/opt/${pkgname}/docs -type f -exec chmod 644 {} \;
    fi

    rm -f "${pkgdir}"/opt/${pkgname}/{uninstall*,Uninstall*} "${pkgdir}"/opt/${pkgname}/*.dat

    install -m644 "${srcdir}"/${pkgname}*.desktop "${pkgdir}"/usr/share/applications/
    ln -s /opt/${pkgname}/appico.png "${pkgdir}"/usr/share/icons/${pkgname}.png
    ln -s /opt/${pkgname}/license.txt "${pkgdir}"/usr/share/licenses/${pkgname}/LICENSE
    ln -s /opt/${pkgname}/ida "${pkgdir}"/usr/bin/ida
}
